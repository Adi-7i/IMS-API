# Environment
PORT=3000
NODE_ENV=development
HOST=127.0.0.1

# Database — path to SQLite database file
DB_PATH=./data/retailops.db

# CORS — comma-separated list of allowed origins (React dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Default low stock threshold (used if not specified on product creation)
DEFAULT_LOW_STOCK_THRESHOLD=5

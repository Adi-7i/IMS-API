{
  "name": "retailops-lite-server",
  "version": "1.0.0",
  "description": "RetailOps Lite — Smart Inventory & Order Management System — Backend API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node src/db/run-migrate.js",
    "db:seed": "node src/db/run-seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^14.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "typescript": "^5.5.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
